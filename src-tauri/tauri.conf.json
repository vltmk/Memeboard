{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memeboard",
  "version": "0.1.0",
  "identifier": "com.memeboard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Memeboard - Soundboard & Virtual Mic",
        "width": 1060,
        "height": 740,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Memeboard Overlay",
        "width": 420,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "url": "index.html?overlay=true"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/driver/*": "driver/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
